{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Jupyter Lab",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        ".venv\\Scripts\\activate && jupyter lab --no-browser --port 8888"
      ],
      "port": 8888,
      "url": "http://localhost:8888"
    },
    {
      "name": "Jupyter Notebook",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        ".venv\\Scripts\\activate && jupyter notebook --no-browser --port 8889"
      ],
      "port": 8889,
      "url": "http://localhost:8889"
    }
  ]
}
