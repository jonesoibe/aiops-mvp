# AIOps MVP Environment Variables
# Copy to .env and fill in actual values

# API Security
AIOPS_API_KEY=demo_key_12345
JWT_SECRET_KEY=your_jwt_secret_key_here
FLASK_ENV=development

# Set to "production" on deployed environments - gates HTTPS-only cookies and
# fail-fast checks (e.g. requiring JWT_SECRET_KEY to be set explicitly).
ENVIRONMENT=development

# Comma-separated list of origins allowed to call the API and connect via
# Socket.IO (CORS). Must match the exact scheme+host+port the app is served
# from - e.g. https://your-app.onrender.com. Defaults to http://localhost:5000
# if unset, which will reject every request from a real deployed origin.
ALLOWED_ORIGINS=http://localhost:5000

# Flask Configuration
SECRET_KEY=your_flask_secret_key_here
FLASK_DEBUG=False

# Session & Cookie Security
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME=3600

# Database Configuration (if using DB)
DB_HOST=localhost
DB_PORT=5432
DB_USER=aiops_user
DB_PASSWORD=secure_password
DB_NAME=aiops_db

# MLflow Configuration
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_BACKEND_STORE_URI=sqlite:///mlruns.db

# Data Sources
DATA_SOURCE=smd
MACHINE_ID=machine-1-1

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/aiops.log

# Security Scanning
BANDIT_ENABLED=true
SAFETY_CHECK_ENABLED=true

# Email (for alerts)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# Monitoring
SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id
